{
  "headers": [
    {
      "source": "/deployment.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.re-view.kr/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://api.re-view.kr/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://api.re-view.kr/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "git": { "deploymentEnabled": false }
}
